# Endpoint that receives orders as JSON (POST). Leave empty until your order
# backend is ready: the checkout will then explain that online ordering is not
# connected and keep the cart. See README.md for the request/response format.
#
# Never put secrets (Telegram bot token, database passwords) in this file:
# every VITE_* variable is bundled into the public JavaScript.
VITE_ORDER_API_URL=
